
menu "AWS IoT Settings"

config AWS_IOT_APP_VERSION
	string "Application version"
	default "v1.0.0"

config AWS_IOT_JSON_MESSAGE_SIZE_MAX
	int "Maximum size of JSON messages"
	default 200
	help
	  Maximum size of JSON messages that are sent to AWS IoT.

config AWS_IOT_PUBLICATION_INTERVAL_SECONDS
	int "Interval in seconds that the sample will publish data"
	default 60

config AWS_IOT_CONNECTION_RETRY_TIMEOUT_SECONDS
	int "Number of seconds between each AWS IoT connection retry"
	default 30

config AWS_IOT_DEVICE_ID_USE_HW_ID
	bool "Use HW ID as device ID"
	select AWS_IOT_CLIENT_ID_APP
	depends on HW_ID_LIBRARY
	help
	  Use the devices's hardware ID as device ID when connecting to AWS IOT

config AWS_IOT_USE_EDRX
	bool "Use edrx to save power"
	default false
	help
	  Use the extended discontineous reception method of the lte to save power

config AWS_IOT_USE_LTE_POWER_OFF
	bool "Use lte power off to save power"
	default false
	help
	  Use the lte power off method to completly power of the lte during device sleep to save power

module = AWS_IOTMQTT
module-str = AWS IoT MQTT
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

endmenu

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
