
&i2c1 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;
    scd4x: scd4x@62 {
        status = "okay";
        compatible = "sensirion,scd41";
        mode = <0>;
        reg = <0x62>;
    };
    sht4x: sht4x@44 {
        status = "okay";
        compatible = "sensirion,sht4x";
        reg = <0x44>;
        repeatability = <2>;
    };
};
&spi2 {
	status = "okay";
	cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";
	spi_epd: spi_epd@0 {
		compatible = "vnd,spi-device";
			reg = <0>;
			spi-max-frequency = <8000000>;
			label = "spi_epd";
	};
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 9)>,
                    <NRF_PSEL(TWIM_SCL, 0, 8)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 9)>,
                    <NRF_PSEL(TWIM_SCL, 0, 8)>;
            low-power-enable;
        };
    };
    spi2_default: spi2_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 22)>,
					<NRF_PSEL(SPIM_MOSI, 0, 23)>,
                    <NRF_PSEL(SPIM_MISO, 0,24)>;
					
		};
	};
	spi2_sleep: spi2_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 22)>,
					<NRF_PSEL(SPIM_MOSI, 0, 23)>,
                    <NRF_PSEL(SPIM_MISO, 0,24)>;

					
			low-power-enable;
		};
	};

    uart0_default: uart0_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 30)>;  
                    // <NRF_PSEL(UART_RTS, 0, 29)>; 
        };
        group2 {
            psels = <NRF_PSEL(UART_RX, 0, 29)>,  
                    <NRF_PSEL(UART_CTS, 0, 26)>; 
            bias-pull-up;
        };
    };

    uart0_sleep: uart0_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 30)>,  
                    <NRF_PSEL(UART_RX, 0, 29)>, 
                    // <NRF_PSEL(UART_RTS, 0, 29)>, 
                    <NRF_PSEL(UART_CTS, 0, 26)>; 
            low-power-enable;
        };
    };
};


/{
    CUSTOM_PINS_PCB {
        compatible = "gpio-keys";
        green_led: green_led{
            gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;   /*GPIO PIN P0.11 */
            label = "Green Led";
        };
        blue_led: blue_led{
            gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;   /*GPIO PIN P0.12 */
            label = "Blue Led";
        };
        red_led: red_led{
            gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;   /*GPIO PIN P0.13 */
            label = "Red Led";
        };
    };
};



&uart1 {
    status = "disabled";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
    label = "UART0";
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};






