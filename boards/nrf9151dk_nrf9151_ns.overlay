&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 9)>,
                    <NRF_PSEL(TWIM_SCL, 0, 8)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 9)>,
                    <NRF_PSEL(TWIM_SCL, 0, 8)>;
            low-power-enable;
        };
    };

};




&uart0 {
    status = "disabled";
};

&uart1 {
    status = "disabled";
};

&spi3 {
    status = "disabled";
};

&i2c2 {
    status = "disabled";
};

&adc {
    status = "disabled";
};

&pwm0 {
    status = "disabled";
};

&button0 {
    status = "disabled";
};
&button1 {
    status = "disabled";
};
&button2 {
    status = "disabled";
};
&button3 {
    status = "disabled";
};
&led0 {
    status = "disabled";
};

&led1 {
